@article{braak_scoping_2026,
	title = {A scoping review of preoperative machine learning models for outcome prediction after endovascular repair of infrarenal abdominal aortic aneurysms},
	volume = {4},
	issn = {29499127},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2949912726001170},
	doi = {10.1016/j.jvsvi.2026.100469},
	abstract = {Objective: In this review article, we provide an overview of machine learning ({ML})-based prediction models using preoperative data to forecast postoperative outcomes in patients undergoing elective endovascular aortic repair for infrarenal abdominal aortic aneurysms.
Methods: A systematic search was conducted in {EMBASE}, {PubMed}, and Web of Science for relevant studies published between 2010 and January 13, 2026 according to the {PRISMA}-{ScR} guidelines. Studies were selected on the basis of their application of endovascular repair and {ML} methodologies. After independent screening by two reviewers, data extraction was performed in accordance with the Critical Appraisal and Data Extraction for Systematic Reviews of Prediction Modeling Studies checklist. The quality of the studies was assessed using the Prediction model Risk Of Bias Assessment Tool for Artificial Intelligence framework. A narrative synthesis was performed due to heterogeneity in outcomes, input features, and modeling approaches.
Results: Of the 3291 screened articles, a final number of 17 studies were included. The most common outcomes assessed were mortality and complication/adverse events, followed by endoleak, reintervention, and sac remodeling prediction. {ML} models showed good predictive performance with little differences between {ML} techniques and, in comparative studies, frequently reported higher performances than traditional statistical approaches. However, performance differences were inconsistent and depended strongly on the type and richness of input features. Most commonly used {ML} methods were tree-based models, followed by kernel-based and boosting methods. Models most frequently relied on age, comorbidities, and smoking status for mortality and complication prediction. For endoleak and reintervention prediction anatomical importance was shown. Most studies emphasized model development over external validation or clinical implementation.
Conclusions: {ML} holds significant promise for outcome prediction after endovascular aortic repair for infrarenal aneurysms, but current models are limited by small sample sizes, lack of standardization, and insufficient validation. The capabilities of {ML} techniques can be further explored by incorporating multimodal features. Moreover, prioritize the creation of standardized, multicenter datasets to enhance generalizability and support the development of robust, clinically applicable {ML} models. ({JVS}-Vascular Insights 2026;4:100469.)},
	pages = {100469},
	journaltitle = {{JVS}-Vascular Insights},
	shortjournal = {{JVS}-Vascular Insights},
	author = {Braak, Milou Ter and Ayyalasomayajula, Venkat and Yeung, Kak Khee},
	urldate = {2026-11-16},
	date = {2026},
	langid = {english},
	file = {PDF:C\:\\Users\\anna2\\Zotero\\storage\\CMKCS3AY\\Braak et al. - 2026 - A scoping review of preoperative machine learning models for outcome prediction after endovascular r.pdf:application/pdf},
}

